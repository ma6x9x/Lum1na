#!/usr/bin/env bash
# Rootless (Procursus/Dopamine): JBPREFIX=/var/jb
JBPREFIX="${THEOS_PACKAGE_DIR_PREFIX:-/var/jb}"
ln -sf "$JBPREFIX/usr/libexec/lum1na-fkt" "$JBPREFIX/usr/bin/lum1na-fkt" 2>/dev/null || true
# one-shot FKT lane probe -> AFC-readable results for the rig
mkdir -p /var/mobile/Documents/Lum1naRoot
OUT=/var/mobile/Documents/Lum1naRoot/row.txt
{
  "/var/jb/usr/libexec/lum1na-fkt" --once 2>&1 || true
  "/var/jb/usr/libexec/kernproc"   2>&1 || true
} > "$OUT" 2>&1
chmod 644 "$OUT"
exit 0
